[Unit]
Description=Niko health and traffic monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/niko-archive/niko-monitor
EnvironmentFile=/etc/niko-monitor.env
Environment=NODE_ENV=production
Environment=MONITOR_HOST=127.0.0.1
Environment=MONITOR_PORT=4182
Environment=MONITOR_STATE_DIR=/var/lib/niko-monitor
Environment=MONITOR_CONFIG=/srv/niko-archive/niko-monitor/monitor.config.production.json
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
StateDirectory=niko-monitor
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
